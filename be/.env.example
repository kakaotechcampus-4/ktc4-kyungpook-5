# 실제 키는 커밋하지 않습니다. 로컬에서는 `cp .env.example .env` 후 값을 채우세요.

# --- DB (app/core/config.py) --------------------------------------------

# 호스트에서 실행할 때의 주소. compose 의 api 컨테이너는 compose.yml 에서 db 호스트로 따로 받는다.
DATABASE_URL=postgresql+psycopg://unyounghae:unyounghae@localhost:5432/unyounghae

# --- AI (app/ai/config.py, AISettings) --------------------------------

# ML API에서 발급받은 엔드포인트 URL. /v1 까지 포함합니다.
AI_API_BASE_URL=

# ML API Serverless 키. Authorization: Bearer 헤더로 전달합니다.
AI_API_KEY=

# 사용할 모델 식별자. 기본값을 두지 않습니다. 메인 모델은 gpt-5.6-terra 입니다.
AI_MODEL=

# 단일 요청 응답 대기 상한(초). 비워두거나 항목이 없으면 60을 사용합니다.
AI_REQUEST_TIMEOUT_SECONDS=

# 임베딩 게이트웨이. 채팅 모델과 다른 경로로 배포되므로 따로 받습니다.
# 문서의 POST .../v1/embeddings 에서 /embeddings 를 뺀 주소, 즉 /v1 까지 넣습니다.
AI_EMBEDDING_BASE_URL=

# 임베딩 배포의 키. 채팅과 같은 키를 쓴다면 비워두고 AI_API_KEY 를 사용합니다.
AI_EMBEDDING_API_KEY=

# 임베딩 모델 식별자. 게이트웨이는 text-embedding-3-small 만 받습니다.
# 모델을 바꾸면 출력 차원이 달라져 저장된 벡터를 다시 만들어야 합니다.
AI_EMBEDDING_MODEL=
