# 실제 키는 커밋하지 않습니다. 로컬에서는 `cp .env.example .env` 후 값을 채우세요.

# --- DB (app/core/config.py) --------------------------------------------

# 호스트에서 실행할 때의 주소. compose 의 api 컨테이너는 compose.yml 에서 db 호스트로 따로 받는다.
DATABASE_URL=postgresql+psycopg://unyounghae:unyounghae@localhost:5432/unyounghae
# FE dev 포트가 다르면 JSON 배열에 해당 origin을 명시합니다.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 신규 업로드 저장소. S3 사용 시 서버 역할에 해당 버킷의 객체 쓰기 권한이 필요합니다.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=ap-northeast-2

# --- AI (app/ai/config.py, AISettings) --------------------------------

# ML API에서 발급받은 엔드포인트 URL. /v1 까지 포함합니다.
AI_API_BASE_URL=

# ML API Serverless 키. Authorization: Bearer 헤더로 전달합니다.
AI_API_KEY=

# 사용할 모델 식별자. 기본값을 두지 않습니다. 지금은 gpt-5.6-luna 를 씁니다.
# 게이트웨이는 모델마다 배포 주소가 다르므로 모델을 바꾸면 AI_API_BASE_URL 도 함께 바꿉니다.
AI_MODEL=

# 단일 요청 응답 대기 상한(초). 비워두거나 항목이 없으면 60을 사용합니다.
AI_REQUEST_TIMEOUT_SECONDS=

# 임베딩 게이트웨이. 채팅 모델과 다른 경로로 배포되므로 따로 받습니다.
# 문서의 POST .../v1/embeddings 에서 /embeddings 를 뺀 주소, 즉 /v1 까지 넣습니다.
AI_EMBEDDING_BASE_URL=

# 임베딩 배포의 키. 채팅과 같은 키를 쓴다면 비워두고 AI_API_KEY 를 사용합니다.
AI_EMBEDDING_API_KEY=

# 임베딩 모델 식별자. 게이트웨이는 text-embedding-3-small 만 받습니다.
# 모델을 바꾸면 출력 차원이 달라져 저장된 벡터를 다시 만들어야 합니다.
AI_EMBEDDING_MODEL=

# --- WS PCM / actual STT -----------------------------------------------
# Whisper multipart endpoint 전체 URL. 실제 배포의 요청 형식은 확인 후 설정합니다.
STT_URL=
STT_API_KEY=
STT_MODEL=whisper-large-v3
STT_TIMEOUT_SECONDS=60
# PCM16 RMS 기준. 실제 마이크 환경에서 조정합니다.
AUDIO_VAD_RMS_THRESHOLD=450

# --- Web Push / one-shot reminder (single BE process) -------------------
# 같은 키 쌍을 유지해야 기존 브라우저 구독을 사용할 수 있습니다.
WEB_PUSH_VAPID_PUBLIC_KEY=
# PEM private key 파일 절대 경로 또는 DER base64. 키 파일은 Git에 추가하지 않습니다.
WEB_PUSH_VAPID_PRIVATE_KEY=
# 운영 연락처 mailto:... 또는 서버 https URL.
WEB_PUSH_VAPID_SUBJECT=
WEB_PUSH_TIMEOUT_SECONDS=10
WEB_PUSH_TTL_SECONDS=3600
REMINDER_DISPATCHER_ENABLED=false
REMINDER_POLL_SECONDS=5

# 실제 베타는 false. test-support와 기존 HTTP dummy STT는 베타 입력 경로가 아닙니다.
TEST_MODE=false

# 카카오 로그인(OAuth). 비워두면 /auth/kakao/callback 이 503으로 거절합니다.
# REDIRECT_URI 는 FE 가 인가 요청에 실어 보낸 값과 한 글자도 다르면 안 됩니다(KOE006).
# FE 는 현재 주소의 origin + /auth/kakao/callback 을 쓰므로 환경마다 값이 다릅니다.
#   로컬:  http://localhost:5173/auth/kakao/callback
#   운영:  https://unyounghae.kro.kr/auth/kakao/callback
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=
# 카카오 디벨로퍼스에서 클라이언트 시크릿을 "사용함"으로 켠 경우에만 채웁니다.
KAKAO_CLIENT_SECRET=
