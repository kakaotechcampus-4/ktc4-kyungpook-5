# BE 공통 환경변수에 합칠 AI 항목의 참고 자료입니다.
# 이 폴더에서 별도 .env를 로드하지 않습니다.
# 실제 키는 커밋하지 않습니다.

# ML API에서 발급받은 엔드포인트 URL. /v1 까지 포함합니다.
AI_API_BASE_URL=

# ML API Serverless 키. Authorization: Bearer 헤더로 전달합니다.
AI_API_KEY=

# 사용할 모델 식별자. 기본값을 두지 않습니다. 예: gpt-5.6-terra
AI_MODEL=

# 단일 요청 응답 대기 상한(초). 미설정 시 60을 사용합니다.
AI_REQUEST_TIMEOUT_SECONDS=
